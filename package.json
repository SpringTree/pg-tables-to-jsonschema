{
  "name": "pg-tables-to-jsonschema",
  "version": "1.1.3",
  "description": "A command-line utility and module to turn postgres tables into JSON Schemas",
  "keywords": [
    "command-line",
    "converter",
    "json-schema",
    "postgresql"
  ],
  "homepage": "https://github.com/SpringTree/pg-tables-to-jsonschema#readme",
  "bugs": {
    "url": "https://github.com/SpringTree/pg-tables-to-jsonschema/issues"
  },
  "license": "ISC",
  "author": {
    "name": "Mark Doeswijk",
    "email": "mdoeswijk@gmail.com",
    "url": "https://github.com/Qwerios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringTree/pg-tables-to-jsonschema.git"
  },
  "bin": {
    "pgtables2jsonschema": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "jsonfile": "^6.1.0",
    "mkdirp": "^3.0.1",
    "pg-structure": "^7.15.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/json-schema": "^7.0.15",
    "@types/jsonfile": "^6.1.4",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
